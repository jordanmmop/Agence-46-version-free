# ─── Moteur IA — 100 % LOCAL, aucune clé API ───────────────────────────────
# L'application embarque ses deux moteurs : « ollama » et « hermes ». Le choix
# se fait dans l'interface (Réglages ⚙️ → Moteur IA) ; ces variables ne sont
# qu'un point de départ.
MOTEUR_IA=ollama
OLLAMA_MODEL=llama3.2
HERMES_MODEL=hermes-3-llama-3.2-3b

# ─── Capital et risque ───
# Ces variables ne sont que des VALEURS INITIALES : les réglages saisis dans
# l'interface (Réglages ⚙️ → Moteur de performance) sont enregistrés et
# prioritaires. Seuls les plafonds de coupure (RiskGuard, section suivante)
# gardent la priorité à l'environnement.
CAPITAL_INITIAL=100000
LEVIER_MAX=10.0
RISQUE_PAR_TRADE_PCT=25.0
VOLUME_MAX_LOT=5.0
OBJECTIF_JOURNALIER=80
CAPITAL_REFERENCE=100
TRADE_COOLDOWN_S=60
SL_DEFAUT_PCT=2.0
TP_DEFAUT_PCT=3.0

# ─── Plafonds de coupure (RiskGuard) ───
# LAISSÉS COMMENTÉS VOLONTAIREMENT. Ces variables ne servent que de valeur
# INITIALE, avant tout réglage dans l'interface. Un fichier .env qui les fixe
# alors que vous réglez aussi ces plafonds dans Réglages ⚙️ → Sécurité crée
# deux sources de vérité pour la même valeur : gardez-en une seule (l'écran de
# réglages), sinon vous ne saurez plus laquelle s'applique.
# RISK_GUARD_ACTIF=true
# PERTE_MAX_JOURNALIERE_PCT=50.0
# MAX_POSITIONS=50
# EXPOSITION_MAX_PCT=1000.0

# ─── Serveur backend ───
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ─── Licence / abonnement Pro ───────────────────────────────────────────────
# CES VARIABLES NE CONTIENNENT AUCUN SECRET, et ne doivent jamais en contenir.
#
# Le statut Pro s'obtient UNIQUEMENT en présentant une licence signée par
# l'émetteur (Ed25519). L'application n'embarque que la clé PUBLIQUE, qui ne
# permet QUE de vérifier une signature — jamais d'en fabriquer une. La clé
# privée reste sur le serveur d'émission et n'apparaît nulle part ici.
#
# Les limites de la version d'essai (6 agents, 20 requêtes/jour, 5/heure) ne
# sont volontairement PAS réglables par variable d'environnement : elles sont
# figées dans python/licence/config.py. Une limite qu'un fichier texte suffit
# à relever n'est pas une limite.

# Clé PUBLIQUE de l'émetteur de licences, en hexadécimal (64 caractères).
# Vide tant qu'aucun émetteur n'est déployé : l'application reste alors en
# version d'essai, quoi qu'on lui présente.
# AGENCE_LICENCE_PUBKEY=

# Émetteur de licences — HTTPS OBLIGATOIRE (le jeton transite dessus).
# Sans cette URL, l'abonnement n'est pas souscriptible depuis l'application.
# LICENCE_API_URL=https://

# Fournisseur d'abonnement : « serveur » (défaut) ou « microsoft_store ».
# AGENCE_LICENCE_FOURNISSEUR=serveur

# Jeton de licence déjà signé, pour une recette sans écrire la configuration.
# Il reste vérifié par signature : ce n'est pas un raccourci vers Pro.
# AGENCE_LICENCE_JETON=

# ─── Paiement Stripe (abonnement Pro) ──────────────────────────────────────
# CES DEUX VARIABLES SONT DES SECRETS. Elles vivent dans l'environnement du
# SERVEUR, jamais dans le dépôt, jamais dans le paquet distribué, jamais dans
# une réponse HTTP. `.env` est ignoré par git (voir .gitignore).
#
# Sans elles, aucun paiement ne peut être CONFIRMÉ : l'application le dit et
# le compte reste fermé. C'est volontaire — mieux vaut ne pas pouvoir encaisser
# que d'ouvrir l'abonnement à qui le demande.
#
# L'application ne voit JAMAIS de numéro de carte : la carte est saisie sur les
# pages de Stripe. Il n'y a donc aucune donnée bancaire à protéger ici.

# Clé secrète Stripe — sert à RELIRE une session de paiement pour savoir si
# elle est réglée. Tableau de bord Stripe → Développeurs → Clés API.
# STRIPE_SECRET_KEY=sk_live_

# Secret de signature du webhook — sert à vérifier que l'appel vient bien de
# Stripe. Tableau de bord Stripe → Développeurs → Webhooks → votre endpoint.
# Endpoint à déclarer : https://<votre-domaine>/api/abonnement/webhook
# Événements : checkout.session.completed, invoice.paid,
#              invoice.payment_succeeded, customer.subscription.deleted
# STRIPE_WEBHOOK_SECRET=whsec_

# URL de succès à renseigner sur CHAQUE lien de paiement Stripe, pour que le
# retour dans l'application vérifie le règlement immédiatement :
#   https://<votre-domaine>/api/abonnement/retour?session_id={CHECKOUT_SESSION_ID}
